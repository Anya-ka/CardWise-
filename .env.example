# Copy this file to .env and fill in your keys
# Never commit .env to version control

# LLM API (OpenAI-compatible — can use OpenAI, Groq, Together, etc.)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1   # change if using another provider
LLM_MODEL=gpt-4o-mini                    # or llama-3-70b-instruct, etc.

# TinyFish API for web research
TINYFISH_API_KEY=your_tinyfish_api_key_here
